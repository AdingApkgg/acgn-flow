POSTGRES_USER="acgn"
POSTGRES_PASSWORD="replace-with-a-random-password"
POSTGRES_DB="acgn_flow"
# 从宿主机 PostgreSQL 18 迁入时保持同一大版本；不得将旧16数据目录直接交给18。
POSTGRES_IMAGE="postgres:18.6-alpine"
POSTGRES_DATA_PATH="/var/lib/postgresql"
DATABASE_URL="postgresql://acgn:replace-with-a-random-password@localhost:5432/acgn_flow"
REDIS_URL="redis://localhost:6379"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="https://your-domain.com"
APP_URL="https://your-domain.com"
APP_NAME="ACGN Flow"
PORT=1270
HOST="0.0.0.0"
UPLOAD_DIR="/app/uploads"
APP_IMAGE="acgn-flow-app:local"
APP_REVISION="development"
APP_PORT=1270
# 默认复用宿主机 Cloudflare Tunnel；只有显式启用 profile 才需该 token。
CLOUDFLARE_TUNNEL_TOKEN=""
