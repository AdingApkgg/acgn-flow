# ACGN Flow 生产环境配置示例
# 复制此文件为 .env.production 并填写实际值

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/acgn_flow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth.js
AUTH_SECRET="生成方式: openssl rand -base64 32"
AUTH_URL="https://af.saop.cc"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@af.saop.cc"

# App
NEXT_PUBLIC_APP_URL="https://af.saop.cc"
NEXT_PUBLIC_APP_NAME="ACGN Flow"

# Uploads
UPLOAD_DIR="./uploads"

# Artalk (评论系统)
NEXT_PUBLIC_ARTALK_SERVER="https://artalk.saop.cc"
NEXT_PUBLIC_ARTALK_SITE="ACGN Flow"
