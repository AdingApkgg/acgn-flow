# Database
DATABASE_URL="postgresql://user:password@localhost:5432/acgn_flow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth.js
# 生成密钥: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"
# 开发环境: http://localhost:3000 | 生产环境: https://your-domain.com
AUTH_URL="http://localhost:3000"

# OAuth 2.0 - 社交登录 (可选，配置后自动启用)
# GitHub: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Discord: https://discord.com/developers/applications
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Email (SMTP) - 可选
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@example.com"

# App
# 开发环境: http://localhost:3000 | 生产环境: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ACGN Flow"

# Uploads
UPLOAD_DIR="./uploads"

# IndexNow (搜索引擎快速索引) - 可选
# 生成密钥: openssl rand -hex 16
# 同时需要创建 public/{key}.txt 文件，内容为密钥本身
INDEXNOW_KEY=""

# Google Search Console API (可选，用于提交 Sitemap)
# 1. 创建 Google Cloud 项目并启用 Search Console API
# 2. 创建服务账号并下载 JSON 密钥
# 3. 在 Search Console 中将服务账号邮箱添加为用户
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

