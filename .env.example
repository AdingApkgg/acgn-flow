# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/anime_flow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth.js
AUTH_SECRET="your-auth-secret-key-here"
AUTH_URL="http://localhost:3000"

# OAuth Providers (可选)
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@example.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ACGN Flow"

# Uploads
UPLOAD_DIR="/app/uploads"

# Artalk (评论系统)
NEXT_PUBLIC_ARTALK_SERVER=""
NEXT_PUBLIC_ARTALK_SITE=""  # Artalk 后台配置的站点名称，如 "ACGN Flow"
