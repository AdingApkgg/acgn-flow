# 在专用构建机配置，Mac 只读改代码，不运行安装、构建或服务。
POSTGRES_USER="acgn"
POSTGRES_PASSWORD="replace-with-a-random-password"
POSTGRES_DB="acgn_flow"
DATABASE_URL="postgresql://acgn:replace-with-a-random-password@localhost:5432/acgn_flow"
REDIS_URL="redis://localhost:6379"

# Better Auth；密钥至少32字符，可用 openssl rand -hex 32 生成。
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
# AUTH_SECRET / AUTH_URL 作为升级兼容别名继续支持。

# 只有 APP_URL / APP_NAME 会显式进入浏览器构建。修改后重新构建客户端。
APP_URL="http://localhost:3000"
APP_NAME="ACGN Flow"
PORT=3000
HOST="127.0.0.1"

# OAuth（完整提供一组ID与密钥才显示按钮）
# 回调路径为 /api/auth/callback/github、/google、/discord。
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
UPLOAD_DIR="./uploads"
INDEXNOW_KEY=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
BILIBILI_COOKIE=""

# 仅隔离验证使用，测试代码不会回退到应用连接。
# TEST_DATABASE_URL="postgresql://acgn_test:password@127.0.0.1:55439/acgn_flow_test"
