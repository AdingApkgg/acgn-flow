{
  "name": "anime-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run prepare:assets && bun --bun vite --host 127.0.0.1",
    "build": "bun run prepare:assets && bun --bun react-router build",
    "start": "NODE_ENV=production bun build/server/index.js",
    "typecheck": "bun --bun react-router typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test tests/auth-policy.test.ts tests/subtitles.test.ts tests/media-source.test.ts tests/media-url.test.ts tests/bilibili-import.test.ts tests/bilibili-http.test.ts tests/ruffle-player.test.ts tests/playback-intent.test.ts src/db/__tests__/safety.test.ts src/server/services/__tests__/query.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:init": "bun scripts/db-init.ts",
    "db:migrate": "bun scripts/db-upgrade.ts",
    "db:verify": "bun scripts/db-check.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/db-seed.ts",
    "db:fixture": "bun scripts/db-fixture.ts",
    "test:browser": "bun --bun playwright test",
    "prepare:assets": "bun scripts/copy-ruffle.cjs",
    "compose:up": "docker compose up -d",
    "compose:logs": "docker compose logs -f app",
    "compose:restart": "docker compose restart app",
    "compose:migrate": "docker compose --profile maintenance run --rm migrate"
  },
